# Azure OpenAI — request from organizers
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small-alpha
# Embedding vector dim — must match the deployed model. 1536 for -small, 3072 for -large.
EMBEDDING_DIM=1536

# Storage — defaults match the provided docker-compose stack
POSTGRES_DSN=postgresql+psycopg://hackuser:hackpass@localhost:5432/hackdb
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Caching + cost control
LLM_CACHE_TTL_SECONDS=3600
SESSION_BUDGET_USD=1.00

# App env
APP_ENV=dev
